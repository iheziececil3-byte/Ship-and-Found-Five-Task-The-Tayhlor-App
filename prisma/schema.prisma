// ==============================================================================
// Tayhlor Database Schema (Prisma)
// Provider: Vercel Postgres with pgvector (PRD Q12, database.md)
// Currency: NGN stored as integer minor units (kobo)
// Test Safeguard: recordEnvironment marker on all models
//
// ------------------------------------------------------------------------------
// FIND A TABLE
// ------------------------------------------------------------------------------
//   1. Identity & access ....... User, Session
//   2. Business ................ Business
//   3. Measurements ............ Measurement
//   4. Orders & fulfilment ..... Order, OrderStatusAudit, Fitting
//   5. Payments ................ Payment, PaymentAttempt
//   6. FAQ assistant ........... FAQDocument, FAQChunk, AssistantMessage
//   7. Compliance .............. ContactAudit
//
// Each model is defined once, under its section, in the order listed above.
// Relations are resolved by name, so a model may reference one defined later.
// ==============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // Connection pooling with pgBouncer
  directUrl = env("POSTGRES_URL_NON_POOLING") // Direct connection for CLI / migrations
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// Enums
//   Identity & access: Role, RecordEnvironment
//   Orders:            OrderStatus, ActorType, FittingOutcome
//   Payments:          PaymentType, PaymentStatus, PaymentAttemptStatus
//   FAQ assistant:     DocumentStatus
// ------------------------------------------------------------------------------

enum Role {
  CUSTOMER
  TAILOR
}

enum RecordEnvironment {
  LIVE
  TEST
  PREVIEW
}

enum OrderStatus {
  SUBMITTED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  READY_FOR_COLLECTION
  COMPLETED
  CANCELLED
}

enum ActorType {
  USER
  SYSTEM
}

enum PaymentType {
  DEPOSIT
  BALANCE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentAttemptStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum FittingOutcome {
  SATISFACTORY
  ALTERATIONS_REQUIRED
}

enum DocumentStatus {
  DRAFT
  APPROVED
}

// ==============================================================================
// 1. Identity & access
// ==============================================================================

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  emailVerified       DateTime?
  emailVerifiedAt     DateTime?
  verificationCode    String?
  verificationExpires DateTime?
  fullName            String
  phone               String?
  passwordHash        String?
  googleSubject       String?           @unique
  role                Role              @default(CUSTOMER)
  recordEnvironment   RecordEnvironment @default(LIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relationships
  measurements      Measurement[]
  orders            Order[]
  auditInitiated    OrderStatusAudit[]
  fittingsRecorded  Fitting[]
  contactAudits     ContactAudit[]
  sessions          Session[]
  assistantMessages AssistantMessage[]

  @@index([email])
  @@index([recordEnvironment])
}

model Session {
  id                String            @id @default(cuid())
  userId            String
  hashedToken       String            @unique
  expiresAt         DateTime
  createdAt         DateTime          @default(now())
  recordEnvironment RecordEnvironment @default(LIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([recordEnvironment])
}

// ==============================================================================
// 2. Business
// ==============================================================================

model Business {
  id                String            @id @default(cuid())
  name              String
  phone             String
  email             String
  address           String
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([recordEnvironment])
}

// ==============================================================================
// 3. Measurements
// ==============================================================================

model Measurement {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  orders            Order[]
  label             String
  chest             Decimal?          @db.Decimal(5, 2)
  waist             Decimal?          @db.Decimal(5, 2)
  hip               Decimal?          @db.Decimal(5, 2)
  shoulder          Decimal?          @db.Decimal(5, 2)
  sleeve            Decimal?          @db.Decimal(5, 2)
  inseam            Decimal?          @db.Decimal(5, 2)
  length            Decimal?          @db.Decimal(5, 2)
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([userId, recordEnvironment])
  @@index([recordEnvironment])
}

// ==============================================================================
// 4. Orders & fulfilment
// ==============================================================================

model Order {
  id                     String            @id @default(cuid())
  customerId             String
  customer               User              @relation(fields: [customerId], references: [id])
  measurementId          String?
  measurement            Measurement?      @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  garmentType            String
  description            String
  measurementsSnapshot   Json
  status                 OrderStatus       @default(SUBMITTED)
  declineReason          String?
  cancellationReason     String?
  quotedTotal            Int? // Amount in minor units: kobo (1 NGN = 100 kobo)
  currency               String            @default("NGN")
  proposedCompletionDate DateTime?
  recordEnvironment      RecordEnvironment @default(LIVE)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  // Relationships
  payments     Payment[]
  statusAudits OrderStatusAudit[]
  fittings     Fitting[]

  @@index([customerId])
  @@index([status])
  @@index([recordEnvironment])
}

// The SQL-only CHECK constraint OrderStatusAudit_actor_check (DAT-11) is defined
// in the migration; Prisma cannot express CHECK constraints in this file.
model OrderStatusAudit {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id])
  actorType         ActorType
  actorId           String?
  actor             User?             @relation(fields: [actorId], references: [id])
  previousStatus    OrderStatus?
  newStatus         OrderStatus
  note              String?
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())

  @@index([orderId])
  @@index([actorId])
  @@index([recordEnvironment])
}

model Fitting {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id])
  outcome           FittingOutcome
  fittingDate       DateTime          @default(now())
  tailorNotes       String?
  recordedById      String
  recordedBy        User              @relation(fields: [recordedById], references: [id])
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())

  @@index([orderId])
  @@index([recordedById])
  @@index([recordEnvironment])
}

// ==============================================================================
// 5. Payments
// ==============================================================================

model Payment {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id])
  type              PaymentType
  amount            Int // Amount in minor units: kobo
  status            PaymentStatus     @default(PENDING)
  paystackReference String            @unique
  providerTxId      String?
  currency          String            @default("NGN")
  provider          String            @default("paystack")
  paidAt            DateTime?
  refundedAt        DateTime?
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  attempts PaymentAttempt[]

  @@index([orderId])
  @@index([orderId, type, status])
  @@index([paystackReference])
  @@index([recordEnvironment])
}

/// One Paystack checkout or verification attempt for a payment. Records are
/// append-only: write new rows for retries, never update an existing attempt.
model PaymentAttempt {
  id                String               @id @default(cuid())
  paymentId         String
  status            PaymentAttemptStatus @default(PENDING)
  amount            Int // Amount in minor units: kobo
  currency          String               @default("NGN")
  provider          String               @default("paystack")
  providerReference String?
  errorCode         String?
  errorMessage      String?
  metadata          Json?
  recordEnvironment RecordEnvironment    @default(LIVE)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
  @@index([providerReference])
  @@index([recordEnvironment])
}

// ==============================================================================
// 6. FAQ assistant
// ==============================================================================

model FAQDocument {
  id                String            @id @default(cuid())
  title             String
  content           String
  status            DocumentStatus    @default(DRAFT)
  approvedAt        DateTime?
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  chunks FAQChunk[]

  @@index([status])
  @@index([recordEnvironment])
}

model FAQChunk {
  id                String            @id @default(cuid())
  documentId        String
  document          FAQDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  heading           String?
  chunkIndex        Int?
  content           String
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([recordEnvironment])
}

model AssistantMessage {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  question          String
  answer            String
  sourceChunkIds    String[]
  grounded          Boolean
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([recordEnvironment])
}

// ==============================================================================
// 7. Compliance
// ==============================================================================

model ContactAudit {
  id                String            @id @default(cuid())
  customerId        String
  customer          User              @relation(fields: [customerId], references: [id])
  changedByTailorId String
  fieldChanged      String
  previousValue     String?
  newValue          String?
  recordEnvironment RecordEnvironment @default(LIVE)
  createdAt         DateTime          @default(now())

  @@index([customerId])
  @@index([customerId, recordEnvironment])
  @@index([recordEnvironment])
}
